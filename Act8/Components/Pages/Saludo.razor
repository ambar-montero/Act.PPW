@page "/saludo"
@rendermode InteractiveServer

<h3>Saludo</h3>

<div class="alert alert-success">
    @Letrero
</div>

<div class="alert alert-info">
    @* @childcontent *@
</div>

<div class="container">
    <div class="row align-items-center">
        <div class="col-2">
            <label for="txtNombre" class="col-form-label">Nombre</label>
        </div>
        <div class="col-10">
            <input id="txtNombre" class="form-control" @bind="Letrero"/>
        </div>
    </div>
</div>
<div class="col-2">
    <button class="btn btn-primary mt-3" @onclick="Saludar">Saludar</button>
</div>
@code {
    [Parameter]
    public string? Letrero { get; set; } = "Cambio de contenido";
    private string _letrero = "Hola Mundo";
    // [Parameter]
    // public renderfragment? childcontent { get; set; }

    void Saludar()
    {
        _letrero = "Hola" + Letrero + "!";
    }
}
