@page "/ciclo"
@rendermode InteractiveServer

<h3>Ciclos</h3>

<div class="container">
    <div class="row align-items-center">
        <div class="col-2">
            <label for="txtEdad" class="col-form-label">Edad</label>
        </div>
        <div class="col-10">
            <input id="txtEdad" class="form-control" @bind="_valorCiclo"/>
        </div>
    </div>
</div>

<div class="col-2">
    <button class="btn btn-primary mt-3" @onclick="Saludar">Saludar</button>
</div>

@if (_mostrar)
{
    <ul>
        @while (_indice < _valorCiclo)
        {
            <li>Valor del ciclo: @_indice</li>
            _indice++;
        }
    </ul>
}

@code {
    private int _valorCiclo, _indice;
    private bool _mostrar = false;
    //private string _letrero = "";

    private void Saludar()
    {
        _indice = 0;
        _mostrar = true;
    }
}
